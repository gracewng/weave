{
  "name": "worth-it",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm --filter @worthit/web dev",
    "build": "pnpm --filter @worthit/web build",
    "start": "pnpm --filter @worthit/web start",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
