{
  "name": "weave",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "pnpm --filter @weave/web dev",
    "build": "pnpm --filter @weave/web build",
    "start": "pnpm --filter @weave/web start",
    "typecheck": "pnpm -r --if-present typecheck && pnpm typecheck:scripts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "seed": "tsx scripts/seed-demo.ts",
    "test": "vitest run",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@types/node": "^26.6.2",
    "openai": "^7.20.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
