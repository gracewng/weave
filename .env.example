# ─── Weave · environment ───────────────────────────────────────────────────
# Copy to apps/web/.env.local for local dev. Never commit real values.

# Demo / reliability
DEMO_MODE=true                      # true = every external API (Gmail, Plaid, eBay, SerpAPI, ElevenLabs) is served from fixtures with realistic latency
NEXT_PUBLIC_DEMO_MODE=true          # same flag, exposed to the browser for UI hints + the hidden demo panel
NEXT_PUBLIC_APP_URL=http://localhost:3000   # public base URL (used for OAuth redirects, invite links, push payloads)
LLM_TIMEOUT_MS=8000                 # per-provider timeout before falling back to the other provider

# Supabase (Postgres + pgvector, Google OAuth, Storage bucket `items`, Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # anon/publishable key (safe for browser; RLS enforces access)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # server only — used for llm_calls logging, gmail_tokens, cron jobs
# Google OAuth client ID/secret are configured in the Supabase dashboard (Auth → Providers → Google), not here.
# Add scope https://www.googleapis.com/auth/gmail.readonly to the Google Cloud consent screen.

# LLM provider A — Meta Model API (Muse Spark). OpenAI-SDK compatible.
META_MODEL_API_KEY=                 # from https://dev.meta.ai  (docs call it MODEL_API_KEY; we accept either)
META_MODEL_BASE_URL=https://api.meta.ai/v1

# LLM provider B — OpenAI (embeddings + checkout spoken line, and fallback for chat tasks)
OPENAI_API_KEY=

# Voice — ElevenLabs text-to-speech (one voice per persona)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_BESTIE=            # voice ID
ELEVENLABS_VOICE_STYLIST=
ELEVENLABS_VOICE_CFO=

# Transactions — Plaid sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Secondhand search — eBay Browse API (client-credentials OAuth)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# Product image lookup — SerpAPI Google Shopping
SERPAPI_KEY=

# Web push (PWA). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@weave.app

# Vercel cron auth — cron routes require `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=

# Optional background-removal microservice (services/rembg). Leave blank to skip.
REMBG_URL=
